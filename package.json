{
  "name": "qatar-securities-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "start:dev": "tsx src/server.ts",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:seed": "tsx src/db/seed.ts",
    "db:seed:historical": "tsx src/db/seed-historical.ts",
    "db:seed:fi-client": "tsx src/db/seed-fi-client.ts",
    "db:remove-debt": "tsx src/db/remove-debt-tickers.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "uat01:reconstruct": "tsx scripts/reconstruct-uat01.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.24.1",
    "@microsoft/signalr": "^10.0.11",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "form-data": "^4.0.6",
    "jsonwebtoken": "^9.0.2",
    "mssql": "^12.7.0",
    "multer": "^1.4.5-lts.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.1.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.14.1",
    "pm2": "^6.0.14",
    "qrcode": "^1.5.4",
    "rss-parser": "^3.13.0",
    "uuid": "^11.1.0",
    "xlsx": "^0.18.5",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mssql": "^12.3.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.15.0",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfkit": "^0.17.6",
    "@types/pg": "^8.11.14",
    "@types/qrcode": "^1.5.6",
    "@types/uuid": "^10.0.0",
    "drizzle-kit": "^0.31.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
