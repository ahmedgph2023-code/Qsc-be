# Copy to `.env` for local backend. Never commit real secrets.

PORT=5001
NODE_ENV=development

# Required in production (NODE_ENV=production). Local may omit (fallback warning).
# JWT_SECRET=replace-with-long-random-string
# ALLOW_JWT_FALLBACK=0

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5433/qse

# External SQL Server (Clients 2 — read-only). Local tunnel: 127.0.0.1:11433 → host 1433.
# MSSQL_HOST=127.0.0.1
# MSSQL_PORT=11433
# MSSQL_USER=sa
# MSSQL_PASSWORD=
# MSSQL_DATABASE=OracleIntegration
# MSSQL_ENCRYPT=false

# Seed: production skips unless RUN_SEED=1. Local seeds unless SKIP_SEED=1.
# SKIP_SEED=1
# RUN_SEED=1
# SEED_RESET_PASSWORDS=1

# Crons (Asia/Qatar)
# FEE_CRON_ENABLED=true
# RISK_CRON_ENABLED=true
# SNAPSHOT_CRON_ENABLED=true

# Live QSC broadcast (Phase 7). Leave unset until URL + JSON samples exist. IPMS will not connect even if set.
# BROADCAST_WS_URL=

# Comma-separated browser origins in shared/prod (e.g. https://ipms.example.com,http://localhost:5173).
# If unset, any Origin is reflected (local-friendly; warn in production).
# CORS_ORIGINS=http://localhost:5173

# Super admin sheet import + system config
# SUPER_ADMIN_USERNAME=super_admin@gmail.com
# SUPER_ADMIN_PASSWORD=

# Client report email (Office365). Password never commit real value.
# SMTP_HOST=smtp.office365.com
# SMTP_PORT=587
# SMTP_USER=qsc.research@qsc.qa
# SMTP_FROM=qsc.research@qsc.qa
# SMTP_PASSWORD=

# Wassenger WhatsApp API for outbound report messages (optional PDF media.url)
# WASSENGER_API_URL=https://api.wassenger.com/v1/messages
# WASSENGER_API_TOKEN=
# Optional public PDF URL attached as media.url (Wassenger downloads it). Per-report hosting TBD.
# WASSENGER_MEDIA_URL=https://example.com/report.pdf
